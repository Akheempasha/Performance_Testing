          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="C_jsonID">
            <stringProp name="RegexExtractor.useHeaders">false</stringProp>
            <stringProp name="RegexExtractor.refname">C_jsonID</stringProp>
            <stringProp name="RegexExtractor.regex">&quot;id&quot;:([1-9]{1}|[0-9]{2}),&quot;email&quot;:&quot;(.+?)&quot;,&quot;first_name&quot;:&quot;(.+?)&quot;,&quot;last_name&quot;:&quot;(.+?)&quot;,</stringProp>
            <stringProp name="RegexExtractor.template">$1$$2$$3$$4$</stringProp>
            <stringProp name="RegexExtractor.default">C_jsonID_Nf</stringProp>
            <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
            <stringProp name="RegexExtractor.match_number">0</stringProp>
          </RegexExtractor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import java.io.File;
import java.io.FileWriter;
import java.text.SimpleDateFormat;
import java.util.Date;

// Create timestamp
//&quot;yyyyMMdd_HHmmss&quot;
String timestamp = new SimpleDateFormat(&quot;yyyyMMdd&quot;).format(new Date());

// Create file path with timestamp
String filePath = &quot;E:/JmeterTest/CapturedData.csv&quot;;
//String filePath = &quot;E:/JmeterTest/CapturedData_&quot; + timestamp + &quot;.csv&quot;;
File file = new File(filePath);

// Captured values from extractors
String id = vars.get(&quot;C_jsonID_g1&quot;);
String email = vars.get(&quot;C_jsonID_g2&quot;);
String first_name = vars.get(&quot;C_jsonID_g3&quot;);
String last_name = vars.get(&quot;C_jsonID_g4&quot;);

// Check if CSV already exists
boolean fileExists = file.exists();

// FileWriter in append mode
FileWriter fw = new FileWriter(filePath, true);

// If file is new → write column header
if (!fileExists) {
    fw.append(&quot;id,email,first_name,last_name\n&quot;);
}

// Append row with captured values
fw.append(id).append(&quot;,&quot;)
  .append(email).append(&quot;,&quot;)
  .append(first_name).append(&quot;,&quot;)
  .append(last_name).append(&quot;\n&quot;);
  
fw.flush();
fw.close();

//log.info(&quot;CSV row added → &quot; + id + &quot;,&quot; + email + &quot;,&quot; + first_name + &quot;,&quot; + last_name);
</stringProp>
            <stringProp name="scriptLanguage">java</stringProp>
          </JSR223PostProcessor>
